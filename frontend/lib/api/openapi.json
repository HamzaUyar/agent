{
  "openapi": "3.1.0",
  "info": {
    "title": "Üs Koruma Karar Destek",
    "version": "0.1.0"
  },
  "paths": {
    "/zones": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Get Zones",
        "description": "Üs ve bölge merkezleri. Bölgelerin sınırı veride yok.",
        "operationId": "get_zones_zones_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZonesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/images": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "List Images",
        "description": "Veri setindeki görüntüler: bölge, çekim saati ve varsa son değerlendirmenin seviyesi.",
        "operationId": "list_images_images_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ImageSummary"
                  },
                  "type": "array",
                  "title": "Response List Images Images Get"
                }
              }
            }
          }
        }
      }
    },
    "/tracks": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "List Tracks",
        "description": "Bütün track'ler, kayıtları olduğu gibi. Her track'in bittiği görüntü, o görüntünün son\ntamamlanmış değerlendirmesindeki temasın seviyesi ve sınıfıyla. Hesap yapılmaz, LLM ya da\ntespit çağrılmaz; değerlendirmesi olmayan track'in seviyesi `None` kalır.",
        "operationId": "list_tracks_tracks_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TrackOverview"
                  },
                  "type": "array",
                  "title": "Response List Tracks Tracks Get"
                }
              }
            }
          }
        }
      }
    },
    "/images/{image_id}": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Get Image",
        "description": "Görüntünün boyutu, çekim saati, köşe koordinatları, merkezi ve bölgesi.",
        "operationId": "get_image_images__image_id__get",
        "parameters": [
          {
            "name": "image_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Image Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageDetail"
                }
              }
            }
          },
          "404": {
            "description": "Görüntü veri setinde yok"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/images/{image_id}/file": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Get Image File",
        "description": "Görüntü dosyası: Supabase modunda `images.file_path` ile bucket'tan, ağsız demoda\nyerel klasörden. Yol veri setindeki kayıttan kurulur, istekten gelen yol kullanılmaz.",
        "operationId": "get_image_file_images__image_id__file_get",
        "parameters": [
          {
            "name": "image_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Image Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Görüntü dosyası",
            "content": {
              "image/jpeg": {},
              "image/png": {}
            }
          },
          "404": {
            "description": "Görüntü veri setinde yok ya da dosyası bulunamadı"
          },
          "502": {
            "description": "Storage'a ulaşılamadı"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/evaluations": {
      "post": {
        "tags": [
          "evaluations"
        ],
        "summary": "Start Evaluation",
        "description": "Görüntüyü değerlendirir; `run`, `step` olayları ve son `brief` olayı akar.\n\nAynı görüntünün başarılı bir değerlendirmesi varsa önbellekten tekrar oynatılır\n(`run.cached = true`); `recompute = true` yeni değerlendirme başlatır.",
        "operationId": "start_evaluation_evaluations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Adım olayları, son olay brief",
            "content": {
              "text/event-stream": {}
            }
          },
          "404": {
            "description": "Görüntü veri setinde yok"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/evaluations/{run_id}": {
      "get": {
        "tags": [
          "evaluations"
        ],
        "summary": "Read Evaluation",
        "description": "Kayıtlı bir değerlendirmeyi bütün adımları ve brief'iyle döndürür.",
        "operationId": "read_evaluation_evaluations__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationRecord"
                }
              }
            }
          },
          "404": {
            "description": "Değerlendirme bulunamadı"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/evaluations/{run_id}/chat": {
      "post": {
        "tags": [
          "evaluations"
        ],
        "summary": "Chat",
        "description": "Değerlendirme hakkında takip sorusu; agent salt okuma araçlarıyla cevaplar.",
        "operationId": "chat_evaluations__run_id__chat_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`tool` olayları, son olay `answer`",
            "content": {
              "text/event-stream": {}
            }
          },
          "404": {
            "description": "Tamamlanmış değerlendirme bulunamadı"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
