# Gizli anahtarlar (şablon: backend/.env.example)
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Veri ve model ağırlıkları repoya girmez
# (yalnız bu klasörler; her "data/" adlı klasör değil)
/data/
/backend/data/
*.pt
*.onnx

# Node / Next.js (frontend; ayrıntılar frontend/.gitignore'da)
node_modules/
.next/
# Backend Node projesi değil; yanlışlıkla oluşan npm dosyaları
/backend/package.json
/backend/package-lock.json

# Claude Code: kişisel ayarlar
# (frontend/.claude/skills takımın ortak skill'leri, .claude/launch.json ortak sunucu ayarı; repoda kalır)
/.claude/skills/
.claude/settings.local.json
.claude/worktrees/

# Editör ve sistem
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.log
.coverage
htmlcov/

# Sentetik paket (Kaggle görüntüleri içerir; scripts/make_synthetic_data.py yeniden üretir)
backend/synthetic/

# Aşama 2 ham veri seti (yerel kopya; repoya girmez)
stage2/
