# ── Supabase ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+psycopg://postgres.<proje>:<şifre>@<pooler-host>:5432/postgres
# Görüntü dosyalarının bucket'ı (images.file_path = <bucket>/<id>.jpg)
STORAGE_BUCKET=drone-images

# ── LLM sağlayıcıları (zincir: app/llm/models.toml) ──
# Organizatörlerin GLM gateway'i (OpenAI uyumlu, glm-5.3-flash) — ana sağlayıcı.
# Anahtar takıma ayrıca iletilir (sk-...). Limitler: 4 eşzamanlı, 60 istek/dk, 15 USD.
GLM_API_KEY=
GLM_API_BASE=https://berriailitellm-databasev1826rc3-production-d691.up.railway.app/v1
# Gerçek harcama açılışta /key/info'dan okunur; bütçe bittiyse ya da çağrı sırasında
# "Budget has been exceeded" gelirse gateway süreç boyunca kapanır, zincir EVREN'e geçer.
# Elle kontrol: curl -s "$GLM_API_BASE/../key/info" -H "Authorization: Bearer $GLM_API_KEY"
# Süreç içi tahmini sınır yalnızca fiyatlar verilirse işler (USD / 1M token):
# GLM_BUDGET_USD=15
# GLM_PRICE_INPUT_PER_MTOK=
# GLM_PRICE_OUTPUT_PER_MTOK=
# EVREN (SSB) — yedek; anahtar evren.ssyz.org.tr, "LLM Çıkarımı" sayfasından.
EVREN_API_KEY=
EVREN_API_BASE=https://evren-llmapi.ssyz.org.tr/v1
# İsteğe bağlı: Claude yedeği
ANTHROPIC_API_KEY=

# ── Uygulama ─────────────────────────────────────────
DATA_DIR=../../stage2
# supabase (varsayılan) ya da package: veri DATA_DIR'den, iddialar CLAIMS_PATH'ten okunur,
# kayıtlar bellekte tutulur (ağsız demo). İddia dosyası: python -m scripts.export_claims
DATA_SOURCE=supabase
CLAIMS_PATH=../../stage2/claims.json
# mock: sahte tespit · evren: ekibin EVREN'deki modeli · model: yerel YOLO ağırlıkları (pip install -e '.[model]')
DETECTOR_MODE=mock
# EVREN model platformu anahtarı (evren.ssyz.org.tr; LLM anahtarından ayrı)
EVREN_MODEL_API_KEY=
# EVREN_DETECTOR_MODEL=u84f118304558/d2-y26l-v2-60ep-mixup01
DETECTOR_WEIGHTS_PATH=
# mock modunda tespitler bu JSON'dan okunur: ekibin EVREN modelinin stage2 çıktısı
# (scripts/export_detections.py); boşsa yerleşik tek örnek
DETECTOR_MOCK_PATH=../../stage2/detections_evren.json
# İsteğe bağlı: modelin eğitildiği çıkarım boyutu (ör. 1280)
# DETECTOR_IMGSZ=1280
